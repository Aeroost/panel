# Local development values. Do not commit real secrets.
# Use `wrangler secret put` for deployed Worker secrets.

# Required for first admin bootstrap. There is no default password.
ADMIN_PASSWORD=

# Required for signed/secure application behavior.
SECRET_KEY=

# Only needed while importing an old gateway_state.json. Remove after migration.
LEGACY_SECRET_KEY=

# Optional Telegram integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Optional display settings.
PUBLIC_ORIGIN=
